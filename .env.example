# Existing text RAG services
DB_NAME=sonia
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Set to "require" for Supabase / hosted Postgres; blank for local Postgres.
DB_SSLMODE=
GOOGLE_API_KEY=
# Gemini models (Google retires old versions; change here when that happens).
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# minimal = fastest first word (~1 s); low/high think longer before answering.
GEMINI_THINKING_LEVEL=minimal
# PDF parsing runs locally with Docling. Set true to OCR scanned PDFs (much slower).
DOCLING_OCR=false
# "pymupdf" skips Docling (needed on small servers like Render free); "docling" uses it.
PDF_PARSER=docling
# "off" skips the torch-based re-ranker (Render free plan).
RERANKER=cross-encoder

# Optional image extraction/storage. Leave all four blank to disable.
# R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_IMAGE_URL_TTL=900

# Supabase Auth: the API verifies users' access tokens against this project.
SUPABASE_URL=
# Only for projects still on the legacy HS256 JWT secret.
SUPABASE_JWT_SECRET=

# Comma-separated origins allowed to call the API (your deployed frontend URL).
FRONTEND_ORIGINS=http://localhost:3000

# This API's public address; MCP clients use {PUBLIC_API_URL}/mcp (OAuth via Supabase).
PUBLIC_API_URL=http://localhost:8000
