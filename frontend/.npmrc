# kokoro-js (browser voice) depends on Transformers.js, which also installs onnxruntime-node. Its install
# script downloads optional CUDA GPU binaries on Linux x64 (Vercel), and that download can fail and break
# `npm install`. Sonia only runs the model in the browser, so the GPU binaries are never needed.
onnxruntime-node-install-cuda=skip
