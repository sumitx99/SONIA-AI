# Copy to .env.local for local development; set the same values in Vercel for production.

# Sonia's backend (FastAPI).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase → Project Settings → API: the project URL, and the "anon" / publishable key (safe for the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
