# Existing text RAG services
DB_NAME=sonia
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Set to "require" for Supabase / hosted Postgres; blank for local Postgres.
DB_SSLMODE=
# Optional: CA certificate file to also verify the database server's identity.
DB_SSL_ROOT_CERT=
# Max database connections per API process.
DB_POOL_SIZE=4
GOOGLE_API_KEY=
# Gemini models (Google retires old versions; change here when that happens).
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# minimal = fastest first word (~1 s); low/high think longer before answering.
GEMINI_THINKING_LEVEL=minimal
# Let answers read web pages linked in the question, and search Google (Google fetches them).
# Search needs Gemini API quota for Google Search grounding; without it Sonia answers without search.
GEMINI_URL_CONTEXT=true
GEMINI_WEB_SEARCH=true
# Optional backup when Gemini is out of quota or down: Groq (free plan works; console.groq.com).
# Each model has its own limits; the second is tried when the first is out of quota.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# PDF parsing runs locally with Docling. Set true to OCR scanned PDFs (much slower).
DOCLING_OCR=false
# "pymupdf" skips Docling (needed on small servers like Render free); "docling" uses it.
PDF_PARSER=docling
# "off" skips the torch-based re-ranker (Render free plan).
RERANKER=cross-encoder

# Optional image extraction/storage. Leave all four blank to disable.
# R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_IMAGE_URL_TTL=900
# Reusable web-image search (Wikimedia Commons). Uses the same R2 configuration; no extra key.
WEB_IMAGE_SEARCH=true

# Supabase Auth: the API verifies users' access tokens against this project.
SUPABASE_URL=
# Only for projects still on the legacy HS256 JWT secret.
SUPABASE_JWT_SECRET=

# Comma-separated origins allowed to call the API (your deployed frontend URL).
FRONTEND_ORIGINS=http://localhost:3000
# The frontend's public address, shown to MCP servers when Sonia signs in to them.
FRONTEND_PUBLIC_URL=http://localhost:3000

# This API's public address; MCP clients use {PUBLIC_API_URL}/mcp (OAuth via Supabase).
PUBLIC_API_URL=http://localhost:8000

# Encrypts secrets of users' MCP connections. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MCP_SECRET_KEY=
# Only for local development: allow MCP server URLs on localhost/private networks.
MCP_ALLOW_PRIVATE_URLS=false

# Optional on Render: render JavaScript pages and capture desktop screenshots.
# Use a Cloudflare API token scoped to Browser Rendering Write.
CLOUDFLARE_BROWSER_ACCOUNT_ID=
CLOUDFLARE_BROWSER_API_TOKEN=


./.venv/bin/python -m uvicorn app.main:app --reload
